<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#1A1A1A">

    <TextView
        android:id="@+id/tv_question"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Question ?"
        android:textColor="#F0F0F0"
        android:textSize="22sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="30dp"/>

    <Button android:id="@+id/btn_ans1" android:layout_width="match_parent" android:layout_height="wrap_content" android:backgroundTint="#0A5D4C" android:layout_marginBottom="10dp"/>
    <Button android:id="@+id/btn_ans2" android:layout_width="match_parent" android:layout_height="wrap_content" android:backgroundTint="#0A5D4C" android:layout_marginBottom="10dp"/>
    <Button android:id="@+id/btn_ans3" android:layout_width="match_parent" android:layout_height="wrap_content" android:backgroundTint="#0A5D4C" android:layout_marginBottom="10dp"/>

    <TextView
        android:id="@+id/tv_feedback"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textSize="18sp"
        android:layout_marginTop="20dp"
        android:visibility="invisible"/>

</LinearLayout>